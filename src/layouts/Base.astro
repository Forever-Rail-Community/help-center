---
import '@fontsource-variable/inter'
import '../styles/global.css'
import { accentStyle, accents } from '../lib/colors'
import { loadHelp } from '../lib/feed'
import { logoPath } from '../lib/logo'
import { siteLinks } from '../lib/links'
import Search from '../components/Search.astro'
import ThemeToggle from '../components/ThemeToggle.astro'

interface Props {
  title?: string // omitted on the home page
  description: string
  structuredData?: Record<string, unknown>[] // schema.org JSON-LD for search engines
  headerSearch?: boolean // the home page has its own large search box
  noindex?: boolean
}
const { title, description, structuredData = [], headerSearch = true, noindex = false } = Astro.props

const help = await loadHelp()
const logo = await logoPath(help)
const { nav, discord } = siteLinks(help)
const siteTitle = `${help.site.name} Help Center`
const FOOTER_TOPICS = 6 // how many categories the footer lists
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle
const canonical = new URL(Astro.url.pathname, Astro.site).toString()

// JSON-LD goes inside a <script>, so "<" is escaped to keep text like "</script>" in an article title harmless.
const jsonLd = (data: Record<string, unknown>) => JSON.stringify(data).replace(/</g, '\\u003c')

// Accent colors for light and dark mode, with readable shades for text and icons (src/lib/colors.ts).
// The dashboard only saves #rrggbb colors; anything else falls back to the main color, then its default.
const mainColor = /^#[0-9a-f]{6}$/i.test(help.site.brandColor) ? help.site.brandColor : '#2f77a5'
const colorStyle = accentStyle(accents(help.site.helpLightAccent, help.site.helpDarkAccent, mainColor))
---
<!doctype html>
<html lang="en" style={colorStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={structuredData.some((d) => d['@type'] === 'Article') ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(logo, Astro.site).toString()} />
    <link rel="icon" href={logo} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {structuredData.map((d) => <script type="application/ld+json" set:html={jsonLd(d)} />)}
    <!-- Light or dark before anything draws: the saved choice, otherwise the device setting. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme')
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', dark)
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- The colored band: the header on every page, plus the search area on the home page (slot "hero"). -->
    <div class="band">
      <header class="container site-header">
        <a class="brand" href="/">
          <img src={logo} alt="" width="32" height="32" />
          <span>{help.site.name} <span class="sub">Help Center</span></span>
        </a>
        <nav class="site-nav" aria-label={`${help.site.name} sites`}>
          <a href="/" class="current" aria-current="true">Help Center</a>
          {nav.map((link) => <a href={link.url}>{link.label}</a>)}
        </nav>
        <div class="header-actions">
          {headerSearch && <div class="header-search"><Search /></div>}
          <ThemeToggle />
          {discord && <a class="btn btn-primary" href={discord}>Join Discord</a>}
        </div>
      </header>
      <slot name="hero" />
    </div>

    <div id="main" style="flex: 1">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/">
            <img src={logo} alt="" width="28" height="28" />
            <span>{help.site.name} <span class="sub">Help Center</span></span>
          </a>
          <p>Guides and answers for the {help.site.name} community.</p>
        </div>
        {help.categories.length > 0 && (
          <nav aria-labelledby="footer-topics">
            <h2 id="footer-topics">Topics</h2>
            {help.categories.slice(0, FOOTER_TOPICS).map((c) => <a href={c.url}>{c.name}</a>)}
          </nav>
        )}
        <nav aria-labelledby="footer-community">
          <h2 id="footer-community">{help.site.name}</h2>
          {nav.map((link) => <a href={link.url}>{link.label}</a>)}
          {discord && <a href={discord}>Discord</a>}
        </nav>
      </div>
    </footer>
  </body>
</html>
