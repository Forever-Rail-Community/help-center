---
import Base from '../layouts/Base.astro'
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <main class="container" style="max-width: 640px; padding-top: 72px; padding-bottom: 96px; text-align: center">
    <h1 style="margin: 0 0 12px; font-size: 32px">Page not found</h1>
    <p style="margin: 0 0 24px; color: var(--muted)">The article may have moved or been taken down. Try searching above, or start from the home page.</p>
    <a class="btn btn-primary" href="/">Go to the Help Center</a>
  </main>
</Base>
