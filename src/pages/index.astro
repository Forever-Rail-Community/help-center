---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Search from '../components/Search.astro'
import { featured, formatDate, gameName, loadHelp, recentlyUpdated } from '../lib/feed'
import { siteLinks } from '../lib/links'

const help = await loadHelp()
const { discord, status, contact } = siteLinks(help)
const recent = recentlyUpdated(help, 6)
const picks = featured(help)

// The game buttons only list games that have their own articles.
const games = [...new Set(help.articles.map((a) => a.game).filter((g) => g !== 'all'))]
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`
---
<Base description={`Guides and answers for the ${help.site.name} community: getting started, Run8, Railroader, the dashboard, and community rules.`} headerSearch={false} heroImage>
  <section class="hero" slot="hero">
    <h1>How can we help?</h1>
    <p>Guides for {help.site.name}: the games, the dashboard, and how we run sessions.</p>
    <Search hero />
    {games.length > 0 && (
      <div class="chips" data-game-filter>
        <span>Show guides for</span>
        <button type="button" class="chip" data-game="any" aria-pressed="true">All games</button>
        {games.map((g) => <button type="button" class="chip" data-game={g} aria-pressed="false">{gameName(g)}</button>)}
      </div>
    )}
  </section>

  <main class="container home">
    {help.categories.length === 0 ? (
      <div class="empty-state">Articles are on their way. Check back soon.</div>
    ) : (
      <>
        {picks.length > 0 && (
          <section aria-labelledby="featured-heading">
            <h2 id="featured-heading" class="section-title">Featured</h2>
            <div class="featured" data-game-list>
              {picks.map((a) => (
                <a class="card featured-card" href={a.url} data-game={a.game}>
                  <span class="eyebrow"><Icon name="star" size={14} /> {a.category.name}</span>
                  <span class="name">{a.title}</span>
                  {a.summary && <span class="desc">{a.summary}</span>}
                  <span class="count">Read article →</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <section aria-labelledby="topics-heading">
          <h2 id="topics-heading" class="section-title">Browse by topic</h2>
          <div class="cards">
            {help.categories.map((c) => (
              <a class="card" href={c.url}>
                <span class="icon"><Icon name={c.icon} /></span>
                <span class="name">{c.name}</span>
                {c.description && <span class="desc">{c.description}</span>}
                <span class="count">{plural(c.articles.length, 'article')}</span>
              </a>
            ))}
          </div>
        </section>

        <div class="home-columns">
          <section aria-labelledby="recent-heading">
            <h2 id="recent-heading" class="section-title">Recently updated</h2>
            <div class="rows" data-game-list>
              {recent.map((a) => (
                <a href={a.url} data-game={a.game}>
                  <span style="display: flex; flex-direction: column; gap: 3px; min-width: 0">
                    <span class="title">{a.title}</span>
                    <span class="summary">{a.category.name} · Updated {formatDate(a.updatedAt)}</span>
                  </span>
                  <Icon name="chevron-right" size={16} class="chevron" />
                </a>
              ))}
            </div>
          </section>

          <aside class="help-card" aria-labelledby="still-heading">
            <span class="icon"><Icon name="life-buoy" /></span>
            <h2 id="still-heading">Still need help?</h2>
            <p>
              {[
                'Submit a ticket and a staff member will follow up in the Operations Center.',
                status && 'If something seems down, check the status page first.'
              ].filter(Boolean).join(' ')}
            </p>
            <div class="actions">
              <a class="btn btn-primary" href={contact}>Submit a ticket</a>
              {discord && <a class="btn" href={discord}>Ask on Discord</a>}
              {status && <a class="btn" href={status}>View status</a>}
            </div>
          </aside>
        </div>
      </>
    )}
  </main>
</Base>

<script>
  // "Show guides for": hides recently updated articles for other games. Articles for all games always show.
  // The choice is remembered for next time.
  const filter = document.querySelector<HTMLElement>('[data-game-filter]')
  if (filter) {
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('button[data-game]')]
    const items = [...document.querySelectorAll<HTMLElement>('[data-game-list] [data-game]')]

    const choose = (game: string) => {
      const known = buttons.some((b) => b.dataset.game === game) ? game : 'any'
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.game === known)))
      items.forEach((item) => {
        item.hidden = known !== 'any' && item.dataset.game !== 'all' && item.dataset.game !== known
      })
      try {
        localStorage.setItem('game', known)
      } catch {}
    }

    buttons.forEach((b) => b.addEventListener('click', () => choose(b.dataset.game!)))
    try {
      choose(localStorage.getItem('game') ?? 'any')
    } catch {}
  }
</script>
