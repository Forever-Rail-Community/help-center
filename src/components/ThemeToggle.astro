---
import Icon from './Icon.astro'
---
<button type="button" class="btn icon-btn theme-toggle" data-theme-toggle aria-label="Switch between light and dark mode">
  <Icon name="moon" size={18} class="moon" />
  <Icon name="sun" size={18} class="sun" />
</button>

<script>
  // The starting mode is set in the page head (see Base.astro) so the page never flashes the wrong colors.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark')
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light')
      } catch {
        // Private browsing can refuse storage; the switch still works for this page.
      }
    })
  }
</script>
