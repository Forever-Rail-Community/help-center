# Required. The dashboard's public help feed. Published articles, categories, and the site name, logo,
# and color from the dashboard's Admin > Appearance all come from here.
HELP_FEED_URL=https://YOUR-DASHBOARD-DOMAIN/api/public/help

# Optional links in the header and footer. Leave a line out to hide that link.
# The dashboard link defaults to the address the feed comes from.
DASHBOARD_URL=
STATUS_URL=
DISCORD_URL=
